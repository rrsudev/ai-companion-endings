# Copy to `.env` and fill in whichever provider you use.
# The provider layer resolves keys in this precedence order:
#   explicit arg  ->  ENDINGS_LM_*  (universal)  ->  provider-specific key
#
# Leave everything blank to run fully offline with the built-in MockProvider
# (ENDINGS_PROVIDER=mock), which is what the tests and the sample pipeline use.

# ---- Which provider/model to use -------------------------------------------
ENDINGS_PROVIDER=mock           # mock | litellm
ENDINGS_MODEL=mock              # e.g. gpt-4o-mini, claude-sonnet-4-5, gemini-2.5-flash, ollama/llama3.1
ENDINGS_JUDGE_MODEL=mock        # model used by the INTIMA judge (ideally independent of the SUT)

# ---- Universal key (works through LiteLLM for any provider) -----------------
ENDINGS_LM_API_KEY=
ENDINGS_LM_API_BASE=            # e.g. http://localhost:11434 for a local OpenAI-compatible server

# ---- Provider-specific keys (fallbacks) ------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- Dual-agent roles (persona diffusion; endings.diffusion) ----------------
# Each role resolves: ENDINGS_<ROLE>_MODEL -> role default (when ENDINGS_PROVIDER=litellm) -> mock.
# Keys/bases are per role and are never shared across roles.
#
# Interactor = Qwen/Qwen3.5-9B. If you serve it on Modal with vLLM's OpenAI-compatible server,
# point the base at your Modal web endpoint (ends in /v1) and put the server's API key here.
ENDINGS_INTERACTOR_MODEL=       # e.g. hosted_vllm/Qwen/Qwen3.5-9B  (or ollama_chat/qwen3.5:9b locally)
ENDINGS_INTERACTOR_API_BASE=    # e.g. https://<workspace>--<app-name>-serve.modal.run/v1
ENDINGS_INTERACTOR_API_KEY=     # the API key your Modal vLLM endpoint checks (--api-key)
# Coach / judge / translator / user simulator = Gemini 3.8 Flash.
ENDINGS_COACH_MODEL=            # e.g. gemini/gemini-3.8-flash
# (judge: see ENDINGS_JUDGE_MODEL above; judge == coach family is a documented bias, OQ-judge)
ENDINGS_TRANSLATOR_MODEL=
ENDINGS_USER_SIM_MODEL=
GEMINI_API_KEY=                 # read natively by LiteLLM for gemini/* models

# ---- Modal account (only needed to deploy/manage the Modal app itself) ------
# Prefer `modal token set --token-id ... --token-secret ...` (stores in ~/.modal.toml).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ---- Data -------------------------------------------------------------------
INTIMA_DATA_PATH=data/intima/intima.jsonl   # local cache of the HF AI-companionship/INTIMA dataset

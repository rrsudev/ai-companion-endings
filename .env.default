# Copy to `.env` and fill in whichever provider you use.
# The provider layer resolves keys in this precedence order:
#   explicit arg  ->  ENDINGS_LM_*  (universal)  ->  provider-specific key
#
# Leave everything blank to run fully offline with the built-in MockProvider
# (ENDINGS_PROVIDER=mock), which is what the tests and the sample pipeline use.

# ---- Which provider/model to use -------------------------------------------
ENDINGS_PROVIDER=mock           # mock | litellm
ENDINGS_MODEL=mock              # e.g. gpt-4o-mini, claude-sonnet-4-5, gemini-2.5-flash, ollama/llama3.1
ENDINGS_JUDGE_MODEL=mock        # model used by the INTIMA judge (ideally independent of the SUT)

# ---- Universal key (works through LiteLLM for any provider) -----------------
ENDINGS_LM_API_KEY=
ENDINGS_LM_API_BASE=            # e.g. http://localhost:11434 for a local OpenAI-compatible server

# ---- Provider-specific keys (fallbacks) ------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- Data -------------------------------------------------------------------
INTIMA_DATA_PATH=data/intima/intima.jsonl   # local cache of the HF AI-companionship/INTIMA dataset
